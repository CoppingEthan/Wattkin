<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette brushes are (re)assigned in code by App.ApplyPalette for light/dark. -->
    <SolidColorBrush x:Key="Lc.Window" Color="#202020" />
    <SolidColorBrush x:Key="Lc.CardBg" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Lc.CardBorder" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Lc.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Lc.SubText" Color="#B8B8B8" />
    <SolidColorBrush x:Key="Lc.Faint" Color="#7E7E7E" />
    <SolidColorBrush x:Key="Lc.Accent" Color="#FFB800" />
    <!-- Brand: the second V of the Wattkin mark is always this amber. -->
    <SolidColorBrush x:Key="Lc.Brand" Color="#FFB800" />
    <SolidColorBrush x:Key="Lc.Good" Color="#6CCB5F" />
    <SolidColorBrush x:Key="Lc.Warn" Color="#FCE100" />
    <SolidColorBrush x:Key="Lc.Bad" Color="#FF99A4" />
    <SolidColorBrush x:Key="Lc.WidgetBg" Color="#E6181818" />
    <SolidColorBrush x:Key="Lc.OnAccent" Color="#111111" />

    <FontFamily x:Key="Lc.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Lc.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Lc.Mono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="Lc.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Lc.CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Lc.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Lc.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Lc.SubText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Lc.Value" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Lc.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Lc.Section" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Lc.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Lc.Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Lc.Faint}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Segmented choice: RadioButtons that look like a pill bar. -->
    <Style x:Key="Lc.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Lc.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{DynamicResource Lc.Window}" BorderBrush="{DynamicResource Lc.CardBorder}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Lc.Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Lc.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Lc.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Lc.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Colour swatch: a round RadioButton filled with its Background; a ring marks the chosen one. -->
    <Style x:Key="Lc.Swatch" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                        <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="{DynamicResource Lc.CardBorder}" StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Lc.SubText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Lc.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Simple settings: Windows 11-style groups of rows (title and one line of text left, one control right). -->
    <Style x:Key="Lc.GroupTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Lc.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,0,0,8" />
    </Style>

    <Style x:Key="Lc.Group" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Lc.CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Lc.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,0,22" />
    </Style>

    <Style x:Key="Lc.Row" TargetType="Grid">
        <Setter Property="Margin" Value="18,13,18,13" />
        <Setter Property="MinHeight" Value="38" />
    </Style>

    <Style x:Key="Lc.RowTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Lc.Text}" />
        <Setter Property="FontSize" Value="13.5" />
    </Style>

    <Style x:Key="Lc.RowText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Lc.SubText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,16,0" />
    </Style>

    <Style x:Key="Lc.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Lc.CardBorder}" />
    </Style>

    <!-- On/off switch (a CheckBox underneath, so IsChecked and Click work as usual). -->
    <Style x:Key="Lc.Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Lc.SubText}" Background="Transparent">
                        <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource Lc.SubText}" HorizontalAlignment="Left" Margin="4,0,0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lc.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Lc.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lc.Accent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Lc.OnAccent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Lc.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Lc.Accent}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="T" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Lc.IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Lc.SubText}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Lc.CardBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
